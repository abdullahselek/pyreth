# Custom FindZLIB module to prioritize targets created by FetchContent
if(TARGET ZLIB::ZLIB)
  set(ZLIB_FOUND TRUE)
  get_target_property(_zlib_inc ZLIB::ZLIB INTERFACE_INCLUDE_DIRECTORIES)
  if(_zlib_inc)
    set(ZLIB_INCLUDE_DIRS "${_zlib_inc}")
    set(ZLIB_INCLUDE_DIR "${_zlib_inc}")
  endif()
  set(ZLIB_LIBRARIES ZLIB::ZLIB)
  set(ZLIB_LIBRARY ZLIB::ZLIB)
  set(ZLIB_VERSION_STRING "1.3.1")
  set(ZLIB_VERSION "1.3.1")
  return()
endif()

if(TARGET zlibstatic)
  add_library(ZLIB::ZLIB ALIAS zlibstatic)
  set(ZLIB_FOUND TRUE)
  get_target_property(_zlib_inc zlibstatic INTERFACE_INCLUDE_DIRECTORIES)
  if(_zlib_inc)
    set(ZLIB_INCLUDE_DIRS "${_zlib_inc}")
    set(ZLIB_INCLUDE_DIR "${_zlib_inc}")
  endif()
  set(ZLIB_LIBRARIES ZLIB::ZLIB)
  set(ZLIB_LIBRARY ZLIB::ZLIB)
  set(ZLIB_VERSION_STRING "1.3.1")
  set(ZLIB_VERSION "1.3.1")
  return()
endif()

if(TARGET zlib)
  add_library(ZLIB::ZLIB ALIAS zlib)
  set(ZLIB_FOUND TRUE)
  get_target_property(_zlib_inc zlib INTERFACE_INCLUDE_DIRECTORIES)
  if(_zlib_inc)
    set(ZLIB_INCLUDE_DIRS "${_zlib_inc}")
    set(ZLIB_INCLUDE_DIR "${_zlib_inc}")
  endif()
  set(ZLIB_LIBRARIES ZLIB::ZLIB)
  set(ZLIB_LIBRARY ZLIB::ZLIB)
  set(ZLIB_VERSION_STRING "1.3.1")
  set(ZLIB_VERSION "1.3.1")
  return()
endif()

# Fallback to CMake's built-in FindZLIB
include(${CMAKE_ROOT}/Modules/FindZLIB.cmake)
